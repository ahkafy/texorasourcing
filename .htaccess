<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Block direct access to sensitive configuration and repository files
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|artisan) - [F,L,NC]

    # Block direct access to internal Laravel directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests)/ - [F,L,NC]
    RewriteRule ^storage/(framework|logs)/ - [F,L,NC]

    # Redirect /public/xxx to /xxx to remove "public" from the URI
    RewriteCond %{THE_REQUEST} \s/+public/(.*?)\s [NC]
    RewriteRule ^public/(.*)$ /$1 [R=301,L]

    # Redirect /public or /public/ to root /
    RewriteCond %{THE_REQUEST} \s/+public/?\s [NC]
    RewriteRule ^public/?$ / [R=301,L]

    # Rewrite root URL to public/
    RewriteRule ^$ public/index.php [L]

    # Rewrite all other requests to the public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
